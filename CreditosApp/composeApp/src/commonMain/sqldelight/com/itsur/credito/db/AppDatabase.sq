-- ============ CATÁLOGOS ============

CREATE TABLE EstadoCredito (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL UNIQUE
);

CREATE TABLE TipoAbono (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL UNIQUE
);

-- ============ TABLAS PRINCIPALES ============

CREATE TABLE Cliente (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    telefono TEXT,
    direccion TEXT,
    limite_credito REAL NOT NULL
);

CREATE TABLE Credito (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    cliente_id INTEGER NOT NULL,
    monto_prestado REAL NOT NULL,
    saldo_pendiente REAL NOT NULL,
    estado_id INTEGER NOT NULL DEFAULT 1,
    fecha_vencimiento TEXT,
    FOREIGN KEY (cliente_id) REFERENCES Cliente(id) ON DELETE CASCADE,
    FOREIGN KEY (estado_id) REFERENCES EstadoCredito(id)
);

CREATE TABLE Abono (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    credito_id INTEGER NOT NULL,
    monto_abonado REAL NOT NULL,
    fecha TEXT NOT NULL,
    tipo_id INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (credito_id) REFERENCES Credito(id) ON DELETE CASCADE,
    FOREIGN KEY (tipo_id) REFERENCES TipoAbono(id)
);

-- ============ PRE-POBLACIÓN DE CATÁLOGOS ============

poblarEstadosCredito:
INSERT OR IGNORE INTO EstadoCredito(id, nombre)
SELECT 1, 'Activo' UNION ALL SELECT 2, 'Liquidado' UNION ALL SELECT 3, 'Vencido';

poblarTiposAbono:
INSERT OR IGNORE INTO TipoAbono(id, nombre)
SELECT 1, 'Efectivo' UNION ALL SELECT 2, 'Transferencia' UNION ALL SELECT 3, 'Cheque';

-- ============ SELECT CATÁLOGOS ============

obtenerEstadosCredito:
SELECT * FROM EstadoCredito;

obtenerTiposAbono:
SELECT * FROM TipoAbono;

-- ============ DASHBOARD ============

obtenerTotalClientes:
SELECT COUNT(*) FROM Cliente;

contarCreditosActivos:
SELECT COUNT(*) FROM Credito WHERE estado_id = 1;

contarCreditosVencidos:
SELECT COUNT(*) FROM Credito WHERE estado_id = 3;

sumarTotalPrestado:
SELECT SUM(monto_prestado) FROM Credito;

sumarTotalPendiente:
SELECT SUM(saldo_pendiente) FROM Credito WHERE estado_id = 1;

obtenerTopDeudores:
SELECT Cliente.nombre, SUM(Credito.saldo_pendiente) AS deuda_total
FROM Credito
JOIN Cliente ON Credito.cliente_id = Cliente.id
WHERE Credito.estado_id = 1
GROUP BY Cliente.id, Cliente.nombre
ORDER BY deuda_total DESC
LIMIT 5;

-- ============ CRUD CLIENTE ============

insertarCliente:
INSERT INTO Cliente(nombre, telefono, direccion, limite_credito)
VALUES (?, ?, ?, ?);

obtenerTodosLosClientes:
SELECT * FROM Cliente;

buscarClientesGenerales:
SELECT * FROM Cliente WHERE nombre LIKE ?;

buscarClientePorNombre:
SELECT Cliente.nombre, Cliente.limite_credito, Credito.saldo_pendiente
FROM Cliente
JOIN Credito ON Cliente.id = Credito.cliente_id
WHERE Cliente.nombre LIKE ?;

actualizarCliente:
UPDATE Cliente
SET nombre = ?, telefono = ?, direccion = ?, limite_credito = ?
WHERE id = ?;

eliminarCliente:
DELETE FROM Cliente WHERE id = ?;

-- ============ CRUD CRÉDITO ============

insertarCredito:
INSERT INTO Credito(cliente_id, monto_prestado, saldo_pendiente, fecha_vencimiento)
VALUES (?, ?, ?, ?);

marcarCreditosVencidos:
UPDATE Credito
SET estado_id = 3
WHERE estado_id = 1
  AND fecha_vencimiento IS NOT NULL
  AND fecha_vencimiento < date('now');

obtenerCreditosPorCliente:
SELECT * FROM Credito WHERE cliente_id = ? ORDER BY id DESC;

obtenerCreditoPorId:
SELECT * FROM Credito WHERE id = ?;

actualizarSaldoPendiente:
UPDATE Credito
SET saldo_pendiente = saldo_pendiente - ?
WHERE id = ?;

liquidarCredito:
UPDATE Credito
SET saldo_pendiente = 0,
    estado_id = 2
WHERE id = ?;

eliminarCredito:
DELETE FROM Credito WHERE id = ?;

-- ============ CRUD ABONO ============

insertarAbono:
INSERT INTO Abono(credito_id, monto_abonado, fecha, tipo_id)
VALUES (?, ?, ?, ?);

obtenerAbonosPorCliente:
SELECT Abono.*
FROM Abono
JOIN Credito ON Abono.credito_id = Credito.id
WHERE Credito.cliente_id = ?;

eliminarAbono:
DELETE FROM Abono WHERE id = ?;

eliminarAbonosPorCredito:
DELETE FROM Abono WHERE credito_id = ?;
